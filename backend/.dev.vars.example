# Local secrets for `wrangler dev`.
#
#   cp .dev.vars.example .dev.vars
#
# This file is the Workers equivalent of the old backend/.env: wrangler loads
# it into `env` automatically for local runs, and it is gitignored. Deployed,
# the same values are set with `wrangler secret put NAME` — never in
# wrangler.toml, whose [vars] block is committed plaintext.
#
# Every value is optional. With an empty file the API still serves and the
# chatbot answers from its built-in offline knowledge base, so a fresh clone is
# fully usable before you have any credentials.

# --- Chatbot provider -------------------------------------------------------
# Set ONE of the two. Claude wins if both are set. With neither, the chatbot
# runs in offline fallback mode (canned answers).

# Anthropic Claude — key from https://console.anthropic.com  (starts with "sk-ant-")
ANTHROPIC_API_KEY=

# OpenAI — key from https://platform.openai.com/api-keys     (starts with "sk-")
OPENAI_API_KEY=

# Optional model overrides. Left commented so llmService.ts's own defaults are
# the single place a model version is chosen — an example file that pins a
# model goes stale the week after the next one ships.
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o

# --- Email (password reset, signup confirmation) ----------------------------
# Resend, over HTTPS — a Worker cannot speak SMTP. With these unset no email
# leaves, and that now includes signing up: an account is only created from the
# link its confirmation email carries.
# RESEND_API_KEY=
# EMAIL_FROM=Compass <noreply@yourdomain>

# Where emailed links point. Set to the Vite dev server so a logged link can be
# opened as-is.
# APP_ORIGIN=http://localhost:5173

# With no Resend key, this is how local signup finishes: reset and signup links
# are written to the `wrangler dev` log instead of being mailed. LOCAL ONLY — a
# link in a log is a live credential.
# DEV_LOG_EMAIL_LINKS="true"
