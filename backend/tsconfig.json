{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    // Workers run the bundle Wrangler produces; tsc is only ever a checker here.
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Dead imports and locals are a checker's job, not a reviewer's. The
    // frontend has caught these since Phase 3 via `tsc -b`; the backend only
    // ran a bare `tsc --noEmit`, so four of them accumulated unnoticed.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,

    // universities.json / scholarships.json are imported as modules rather than
    // read off disk — a Worker has no filesystem to read them from.
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  // ../functions was the repo-root Pages Function and was included here because
  // a tsconfig inside functions/ could not resolve "@cloudflare/workers-types"
  // from the `types` array — nothing above that directory had node_modules. The
  // 2026-09-18 move to Workers deleted the directory, and the include with it:
  // a glob matching nothing is not inert, it is a claim that stops being true
  // without anything failing.
  "include": ["src/**/*.ts", "test/**/*.ts", "*.ts", "*.d.ts", "data/*.json"],
  "exclude": ["node_modules"]
}
