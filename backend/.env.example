# Compass backend — environment template.
#
#   cp .env.example .env
#
# Every value here is optional. With an empty file the API still boots and the
# chatbot answers from its built-in offline knowledge base, so a fresh clone is
# fully usable before you have any credentials.

# Port the API server listens on. An exported PORT in your shell wins over this
# file (dotenv never overwrites a variable that is already set), which matters
# for the combined `npm run dev` — the frontend proxy expects the API on 4000.
PORT=4000

# --- Chatbot provider -------------------------------------------------------
# Set ONE of the two keys below. Claude wins if both are set.
# With neither, the chatbot runs in offline fallback mode (canned answers).

# Anthropic Claude — key from https://console.anthropic.com  (starts with "sk-ant-")
ANTHROPIC_API_KEY=

# OpenAI — key from https://platform.openai.com/api-keys     (starts with "sk-")
OPENAI_API_KEY=

# Optional model overrides. Left commented so llmService.js's own defaults are
# the single place a model version is chosen — an example file that pins a model
# goes stale the week after the next one ships.
# ANTHROPIC_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o

# --- Hosting ----------------------------------------------------------------
# Only needed once this runs somewhere other than your laptop.

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to http://localhost:5173 (the Vite dev server) when unset.
# CORS_ORIGIN=https://compass.example.com

# Number of reverse proxies in front of this app, for correct client-IP
# detection in the rate limiter. 0 = none (local). Render and Fly.io are 1.
# Guessing high lets a client spoof X-Forwarded-For and bypass rate limits,
# so set it to the real hop count, not a safe-sounding large number.
# TRUST_PROXY=1

# Where the SQLite file lives. Defaults to backend/data/compass.db.
# On a host, point this at a persistent volume. ":memory:" is honoured.
# COMPASS_DB=/data/compass.db

# NODE_ENV=production
