# Copy this file to ".env" and fill in your values.

# Port the API server listens on
PORT=4000

# --- Chatbot provider -------------------------------------------------------
# Set ONE of the two keys below. Claude wins if both are set.
# With neither, the chatbot runs in offline fallback mode (canned answers).

# Anthropic Claude — key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model overrides
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-4o
