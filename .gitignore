# Dependencies
node_modules/

# Env / secrets — these hold the real ANTHROPIC_API_KEY / OPENAI_API_KEY and
# must only ever live on this machine, never in the repo. `.dev.vars` is the
# Workers equivalent of `.env`: wrangler loads it for local runs, and deployed
# the same values are set with `wrangler secret put`.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.local

# Local D1 state — wrangler's SQLite files for `wrangler dev` and the test
# runs, holding whatever profiles were typed into this machine's copy of the
# app. Never in the repo.
backend/.wrangler/

# The same, for the root: `npm run preview` runs `wrangler pages dev` from here
# and writes its own build cache and state alongside this file. It is pointed
# at backend/.wrangler/state for D1 so the two dev loops share one database,
# but the directory itself still appears.
/.wrangler/

# The pre-D1 SQLite database, from when the backend ran on node:sqlite. Kept
# ignored so an existing clone doesn't suddenly start offering to commit it.
backend/data/compass.db
backend/data/compass.db-wal
backend/data/compass.db-shm

# Build output
dist/
build/

# TypeScript incremental build cache — regenerated on every `tsc` run,
# machine-specific, and just noise in diffs if committed.
*.tsbuildinfo

# `wrangler types` output — regenerated by `npm run cf-typegen` and bakes in
# whatever is in the local .env, so it differs per machine. env.d.ts is the
# hand-written, committed alternative that doesn't have that problem.
worker-configuration.d.ts

# Test coverage output.
coverage/

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/

# Claude Code — project-local session state and permission overrides.
# This is how Claude reads/remembers this project on this machine, not part
# of the app; launch.json (dev-server config) is deliberately NOT ignored
# here since it's meant to be shared with anyone who clones the repo.
.claude/settings.local.json

# Local design-standards brief, kept on this machine and deliberately out of
# the repo. It steers how the UI gets built but is not part of the app, and
# until now it was untracked-but-not-ignored — which is one `git add -A` away
# from being committed by accident. This line is what makes that impossible
# rather than merely careful.
ClaudeWebDesign.md
